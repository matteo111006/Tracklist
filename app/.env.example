# Server configuration. Never prefix secrets with VITE_.
APP_URL="http://127.0.0.1:3000"

# Database Turso (obbligatorio su Render, facoltativo in locale).
# Se vuoto, l'app usa il file locale .data/tracklist.db.
# Valori da: turso db show <nome> --url  e  turso db tokens create <nome>
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Password reset emails (Resend).
# Create your account and API key at https://resend.com/api-keys
# EMAIL_FROM must use an authorized/verified sending domain.
# Production example: TRACKLIST <noreply@auth.your-domain.it>
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional Spotify Web API credentials.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Optional Gemini AI. Server-only; never prefix the key with VITE_.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Optional migration owner. Normally read from .data/legacy-owner.json.
# Other accounts cannot access the historical catalog.
# LEGACY_CATALOG_OWNER_ID=""
